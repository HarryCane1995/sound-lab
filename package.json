{
  "name": "sound-lab",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tests/audio.mjs",
    "test:ui": "node tests/smoke.mjs",
    "test:midi:core": "node tests/midi-core.mjs",
    "test:midi:audio": "node tests/midi-audio.mjs",
    "test:midi:ui": "node tests/midi-ui.mjs",
    "test:midi": "npm run test:midi:core && npm run test:midi:audio && npm run test:midi:ui",
    "test:poly:audio": "node tests/poly-audio.mjs",
    "test:poly:ui": "node tests/poly-ui.mjs",
    "test:poly": "npm run test:poly:audio && npm run test:poly:ui",
    "test:additive:audio": "node tests/additive-audio.mjs",
    "test:additive:ui": "node tests/additive-ui.mjs",
    "test:additive": "npm run test:additive:audio && npm run test:additive:ui",
    "test:declick:audio": "node tests/declick-audio.mjs",
    "test:declick:ui": "node tests/declick-ui.mjs",
    "test:declick": "npm run test:declick:audio && npm run test:declick:ui",
    "test:phrase:core": "node tests/phrase-core.mjs",
    "test:phrase:audio": "node tests/phrase-audio.mjs",
    "test:phrase:ui": "node tests/phrase-ui.mjs",
    "test:phrase": "npm run test:phrase:core && npm run test:phrase:audio && npm run test:phrase:ui",
    "test:all": "npm test && npm run test:ui && npm run test:midi && npm run test:poly && npm run test:additive && npm run test:declick && npm run test:phrase && npm run test:pwa && npm run test:gpu && npm run test:studio && npm run test:performance",
    "typecheck": "tsc -b",
    "test:pwa": "node tests/pwa.mjs",
    "test:gpu:prototype": "node tests/gpu-prototype.mjs",
    "test:gpu": "npm run test:gpu:prototype && node tests/gpu.mjs",
    "test:studio": "node tests/studio-ui.mjs",
    "test:performance": "node tests/performance.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
