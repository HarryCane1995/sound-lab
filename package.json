{
  "name": "sound-lab",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tests/audio.mjs",
    "test:ui": "node tests/smoke.mjs",
    "test:midi:core": "node tests/midi-core.mjs",
    "test:midi:audio": "node tests/midi-audio.mjs",
    "test:midi:ui": "node tests/midi-ui.mjs",
    "test:midi": "npm run test:midi:core && npm run test:midi:audio && npm run test:midi:ui",
    "test:poly:audio": "node tests/poly-audio.mjs",
    "test:poly:ui": "node tests/poly-ui.mjs",
    "test:poly": "npm run test:poly:audio && npm run test:poly:ui",
    "test:all": "npm test && npm run test:ui && npm run test:midi && npm run test:poly"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
